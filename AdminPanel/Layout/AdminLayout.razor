@inherits LayoutComponentBase
@inject NavigationManager Navigation

<!-- Main container -->
<main class="full-box main-container">
    <!-- Nav lateral -->
    <section class="full-box nav-lateral">
        <div class="full-box nav-lateral-bg show-nav-lateral"></div>
        <div class="full-box nav-lateral-content">
            <figure class="full-box nav-lateral-avatar">
                <i class="far fa-times-circle show-nav-lateral"></i>
                <img src="assets/avatar/Avatar.png" class="img-fluid" alt="Avatar">
                <figcaption class="roboto-medium text-center">
                    Carlos Alfaro <br><small class="roboto-condensed-light">Web Developer</small>
                </figcaption>
            </figure>
            <div class="full-box nav-lateral-bar"></div>
            <nav class="full-box nav-lateral-menu">
                <ul>
                    <li>
                        <a href="/" class="@GetActiveClass("/")">
                            <i class="fab fa-dashcube fa-fw"></i> &nbsp; Dashboard
                        </a>
                    </li>

                    <li>
                        <a href="#" class="nav-btn-submenu">
                            <i class="fas fa-user-tie fa-fw"></i> &nbsp; Administrator 
                            <i class="fas fa-chevron-down"></i>
                        </a>
                        <ul>
                            <li>
                                <a href="/listadmin" class="@GetActiveClass("/listadmin")">
                                    <i class="fas fa-users fa-fw"></i> &nbsp; List admin
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>
    </section>

    <!-- Page content -->
    <section class="full-box page-content">
        <nav class="full-box navbar-info">
            <a href="#" class="float-left show-nav-lateral"><i class="fas fa-exchange-alt"></i></a>
            <a href="#"><i class="far fa-question-circle"></i></a>
            <a href="#"><i class="fas fa-user-cog"></i></a>
            <a href="#" class="btn-exit-system"><i class="fas fa-power-off"></i></a>
        </nav>

        @Body
    </section>
</main>

@code {
    private string GetActiveClass(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        return currentPath == path ? "active" : "";
    }
}
